config_version=5

[application]

config/name="Prueba-Roguelike"
run/main_scene="uid://d0slvxbu2rsoe"
config/features=PackedStringArray("4.6", "Mobile")

[autoload]

GameManager="*uid://b6oteyek7vkkr"
SoundManager="*uid://dtu4qc7p35bng"
TutorialManager="*uid://d0adte4yhfndb"
SaveManager="*uid://dhlp5uthfovv7"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Prueba-Roguelike"

[global_group]

